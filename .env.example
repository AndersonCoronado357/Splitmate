# ============================================================
# Variables de entorno — Splitmate
# Copia este archivo a `.env` y reemplaza los valores.
# `.env` NUNCA se sube al repo (está en .gitignore).
# ============================================================

# --- Supabase: cliente público (browser) ---
# La llave "publishable" (antes llamada "anon") puede vivir en el
# bundle del cliente. La protección de datos depende de RLS, no
# de ocultar esta llave.

# URL del proyecto, ej.: https://xxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_URL="REEMPLAZAR"

# Llave publishable (formato sb_publishable_*)
PUBLIC_SUPABASE_PUBLISHABLE_KEY="REEMPLAZAR"

# --- Supabase: cliente de servidor (NO browser) ---
# La llave "secret" (antes llamada "service_role") salta todas las
# políticas RLS. SOLO debe usarse desde código de servidor
# (endpoints +server.ts, acciones, edge functions). Nunca importarla
# desde código del navegador.

# Llave secret (formato sb_secret_*)
SUPABASE_SECRET_KEY="REEMPLAZAR"

# Contraseña de la base de datos (para aplicar migraciones desde scripts/migrate.mjs).
SUPABASE_DB_PASSWORD="REEMPLAZAR"

# Secret para autenticar el cron de recordatorios mensuales.
# Genera uno largo aleatorio (32+ chars). El endpoint
# /api/push/recordatorios-fijos exige `x-cron-secret: <ese valor>`.
CRON_SECRET="REEMPLAZAR"
